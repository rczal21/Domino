#include "Dom_DHIR_Model.h"
#include <stdio.h>
#include <time.h>

typedef struct Peca[28]{
	int ladoD; //lado direito 
	int ladoE; //lado esquerdo 
	char status; 
}tipoPeca; 

void embaralhar(Peca pecas[], int n){  //[] chama o pecas
	for(int i = n -1; i > 0; i--){
		int j = rand() % (i + 1); 
		Peca temp = pecas[i]; 
		pecas[i] = pecas [j];
		pecas [j] = temp;
	}
	

}
