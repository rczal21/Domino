//gerar as pecas
void gerarPecas()
{
	int p, i, j;     //gerar as 28 pecas
	
	p = 0;
	for (i = 0; i <= 6; i++)
		for(j = i; j <= 6; j++)
		 {
		 	pecas[p].lado1 = i;
		 	pecas[p].lado2 = j;
		 	pecas[p].status = NULL;
		 	p++;
		 }
}

void embaralharPecas(Peca pecas[], int n){  //[] chama o pecas
	for(int i = n -1; i > 0; i--){
		int j = rand() % (i + 1); 
		Peca temp = pecas[i]; 
		pecas[i] = pecas [j];
		pecas [j] = temp;
	}
	

}
